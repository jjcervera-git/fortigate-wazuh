<group name="fortigate,fortigate_dos,">

  <rule id="101500" level="0">
    <decoded_as>fortigate-dos</decoded_as>
    <description>FortiGate: evento de anomalia/DoS.</description>
    <options>no_full_log</options>
  </rule>

  <rule id="101501" level="8">
    <if_sid>101500</if_sid>
    <description>FortiGate DoS: anomalia "$attack" detectada desde $srcip -> $dstip ($count/$threshold).</description>
    <mitre>
      <id>T1498</id>
    </mitre>
    <group>fortigate_dos_anomaly,availability,</group>
  </rule>

  <rule id="101502" level="12">
    <if_sid>101501</if_sid>
    <field name="dos_action">block|drop</field>
    <description>FortiGate DoS: ataque "$attack" BLOQUEADO desde $srcip -> $dstip (umbral superado: $count/$threshold).</description>
    <mitre>
      <id>T1498.001</id>
    </mitre>
    <group>fortigate_dos_blocked,attack,pci_dss_11.4,</group>
  </rule>

  <rule id="101503" level="14">
    <if_sid>101501</if_sid>
    <field name="dos_action">pass|monitor</field>
    <description>FortiGate DoS: ataque "$attack" detectado pero NO bloqueado desde $srcip -> $dstip. Servicio potencialmente afectado.</description>
    <mitre>
      <id>T1498.001</id>
    </mitre>
    <group>fortigate_dos_not_blocked,availability,attack,</group>
  </rule>

  <rule id="101504" level="13">
    <if_sid>101501</if_sid>
    <field name="attack" type="pcre2">(?i)(syn.?flood|udp.?flood|icmp.?flood)</field>
    <description>FortiGate DoS: inundacion de tipo "$attack" detectada contra $dstip desde $srcip.</description>
    <mitre>
      <id>T1498.001</id>
    </mitre>
    <group>fortigate_dos_flood,attack,</group>
  </rule>

  <rule id="101505" level="15" frequency="3" timeframe="120">
    <if_matched_sid>101503</if_matched_sid>
    <same_dstip />
    <description>FortiGate DoS: multiples ataques DoS no bloqueados contra $dstip en 2 min. Servicio en riesgo critico de disponibilidad.</description>
    <mitre>
      <id>T1498</id>
    </mitre>
    <group>fortigate_dos_critical,availability,attack,</group>
  </rule>

</group>
