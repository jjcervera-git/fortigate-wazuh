<group name="fortigate,fortigate_dns,">

  <rule id="101000" level="0">
    <decoded_as>fortigate-dns</decoded_as>
    <description>FortiGate: evento de DNS filter.</description>
    <options>no_full_log</options>
  </rule>

  <rule id="101001" level="6">
    <if_sid>101000</if_sid>
    <field name="qname" type="pcre2">(?i)(\.ru$|\.tk$|\.top$|\.xyz$)</field>
    <description>FortiGate DNS: consulta a dominio de TLD de riesgo elevado "$qname" desde $srcip.</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
    <group>fortigate_dns_risky_tld,</group>
  </rule>

  <rule id="101002" level="9">
    <if_sid>101000</if_sid>
    <field name="qname" type="pcre2">^([a-z0-9]{16,}\.)</field>
    <description>FortiGate DNS: consulta a subdominio de aspecto algoritmico (posible DGA/tunneling) "$qname" desde $srcip.</description>
    <mitre>
      <id>T1568.002</id>
      <id>T1071.004</id>
    </mitre>
    <group>fortigate_dns_dga,attack,</group>
  </rule>

  <rule id="101003" level="10" frequency="15" timeframe="60">
    <if_matched_sid>101000</if_matched_sid>
    <same_srcip />
    <description>FortiGate DNS: volumen anomalo de consultas DNS desde $srcip (15+ en 1 min). Posible tunel DNS o exfiltracion.</description>
    <mitre>
      <id>T1048</id>
      <id>T1071.004</id>
    </mitre>
    <group>fortigate_dns_tunneling,attack,</group>
  </rule>

  <rule id="101004" level="7">
    <if_sid>101000</if_sid>
    <field name="qtype">TXT|NULL</field>
    <description>FortiGate DNS: consulta de tipo $qtype (poco habitual) a "$qname" desde $srcip. Revisar posible C2 sobre DNS.</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
    <group>fortigate_dns_unusual_type,</group>
  </rule>

</group>
