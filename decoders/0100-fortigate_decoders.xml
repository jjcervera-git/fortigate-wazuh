<!--
  FortiGate FortiOS 7.4 - Decoders para Wazuh 4.14
  Formato de log: syslog key=value (RFC5424/RFC3164), ej:

  date=2026-07-09 time=10:15:23 devname="FGT-EDGE01" devid="FG100FTK20012345"
  eventtime=1720520123 tz="+0200" logid="0000000013" type="traffic"
  subtype="forward" level="notice" vd="root" srcip=192.168.1.10 ...

  Estrategia: un decoder raiz ("fortigate") que reconoce la cabecera comun
  (date/time/devname/devid), un decoder de cabecera que extrae los campos
  comunes a TODOS los logtypes (logid, type, subtype, level, vd, eventtime),
  y decoders hijos por type/subtype que fijan el "decoder.name" que usan
  las reglas (fortigate-firewall-v5, fortigate-vpn, fortigate-ips, etc.)

  Cada decoder hijo usa multiples <regex offset="after_parent"> + <order>
  para extraer campos clave=valor sin importar el orden/posicion en el
  log (los logs de FortiOS no garantizan orden fijo de campos opcionales).
-->

<!-- ============================================================= -->
<!-- 1. DECODER RAIZ                                                -->
<!-- ============================================================= -->
<decoder name="fortigate">
  <prematch>^date=\d\d\d\d-\d\d-\d\d time=\d\d:\d\d:\d\d</prematch>
</decoder>

<!-- ============================================================= -->
<!-- 2. CABECERA COMUN (devname, devid, logid, type, subtype, etc.) -->
<!--    Se aplica a TODOS los logs de FortiGate                     -->
<!-- ============================================================= -->
<decoder name="fortigate-header">
  <parent>fortigate</parent>
  <use_own_name>no</use_own_name>

  <regex offset="after_parent">\s+devname="([^"]+)"</regex>
  <order>devname</order>

  <regex offset="after_parent">\s+devid="([^"]+)"</regex>
  <order>devid</order>

  <regex offset="after_parent">\s+eventtime=(\d+)</regex>
  <order>eventtime</order>

  <regex offset="after_parent">\s+tz="([^"]+)"</regex>
  <order>tz</order>

  <regex offset="after_parent">\s+logid="?(\d+)"?</regex>
  <order>logid</order>

  <regex offset="after_parent">\s+type="([^"]+)"</regex>
  <order>type</order>

  <regex offset="after_parent">\s+subtype="([^"]+)"</regex>
  <order>subtype</order>

  <regex offset="after_parent">\s+level="([^"]+)"</regex>
  <order>level</order>

  <regex offset="after_parent">\s+vd="([^"]+)"</regex>
  <order>vd</order>

  <regex offset="after_parent">\s+action="([^"]+)"</regex>
  <order>action</order>

  <regex offset="after_parent">\s+msg="([^"]+)"</regex>
  <order>msg</order>
</decoder>

<!-- ============================================================= -->
<!-- 3. FIREWALL / TRAFFIC (type=traffic) - Decoder oficial:        -->
<!--    fortigate-firewall-v5                                       -->
<!-- ============================================================= -->
<decoder name="fortigate-firewall-v5">
  <parent>fortigate</parent>
  <regex offset="after_parent">\.*type="traffic"</regex>
</decoder>

<decoder name="fortigate-firewall-v5">
  <parent>fortigate-firewall-v5</parent>
  <use_own_name>yes</use_own_name>

  <regex offset="after_parent">\s+srcip=(\d+\.\d+\.\d+\.\d+)</regex>
  <order>srcip</order>

  <regex offset="after_parent">\s+srcport=(\d+)</regex>
  <order>srcport</order>

  <regex offset="after_parent">\s+srcintf="([^"]+)"</regex>
  <order>srcintf</order>

  <regex offset="after_parent">\s+dstip=(\d+\.\d+\.\d+\.\d+)</regex>
  <order>dstip</order>

  <regex offset="after_parent">\s+dstport=(\d+)</regex>
  <order>dstport</order>

  <regex offset="after_parent">\s+dstintf="([^"]+)"</regex>
  <order>dstintf</order>

  <regex offset="after_parent">\s+proto=(\d+)</regex>
  <order>protocol</order>

  <regex offset="after_parent">\s+policyid=(\d+)</regex>
  <order>policyid</order>

  <regex offset="after_parent">\s+policyname="([^"]+)"</regex>
  <order>policyname</order>

  <regex offset="after_parent">\s+service="([^"]+)"</regex>
  <order>service</order>

  <regex offset="after_parent">\s+srccountry="([^"]+)"</regex>
  <order>srccountry</order>

  <regex offset="after_parent">\s+dstcountry="([^"]+)"</regex>
  <order>dstcountry</order>

  <regex offset="after_parent">\s+sentbyte=(\d+)</regex>
  <order>sentbyte</order>

  <regex offset="after_parent">\s+rcvdbyte=(\d+)</regex>
  <order>rcvdbyte</order>

  <regex offset="after_parent">\s+duration=(\d+)</regex>
  <order>duration</order>

  <regex offset="after_parent">\s+sessionid=(\d+)</regex>
  <order>sessionid</order>

  <regex offset="after_parent">\s+crlevel="([^"]+)"</regex>
  <order>crlevel</order>
</decoder>

<!-- ============================================================= -->
<!-- 4. VPN (type=vpn, IPsec tunnel up/down; o type=event          -->
<!--    subtype=vpn, SSL-VPN login/logout en FortiOS 7.x)           -->
<!-- ============================================================= -->
<decoder name="fortigate-vpn">
  <parent>fortigate</parent>
  <regex offset="after_parent">\.*type="vpn"</regex>
</decoder>

<decoder name="fortigate-vpn">
  <parent>fortigate</parent>
  <regex offset="after_parent">\.*type="event" subtype="vpn"</regex>
</decoder>

<decoder name="fortigate-vpn">
  <parent>fortigate-vpn</parent>
  <use_own_name>yes</use_own_name>

  <regex offset="after_parent">\s+remip=(\d+\.\d+\.\d+\.\d+)</regex>
  <order>srcip</order>

  <regex offset="after_parent">\s+locip=(\d+\.\d+\.\d+\.\d+)</regex>
  <order>dstip</order>

  <regex offset="after_parent">\s+user="([^"]+)"</regex>
  <order>user</order>

  <regex offset="after_parent">\s+remotewanaddr=(\d+\.\d+\.\d+\.\d+)</regex>
  <order>remotewanaddr</order>

  <regex offset="after_parent">\s+tunneltype="([^"]+)"</regex>
  <order>tunneltype</order>

  <regex offset="after_parent">\s+tunnelid=(\d+)</regex>
  <order>tunnelid</order>

  <regex offset="after_parent">\s+reason="([^"]+)"</regex>
  <order>reason</order>

  <regex offset="after_parent">\s+logdesc="([^"]+)"</regex>
  <order>logdesc</order>

  <regex offset="after_parent">\s+login="([^"]+)"</regex>
  <order>login</order>

  <regex offset="after_parent">\s+group="([^"]+)"</regex>
  <order>usergroup</order>

  <regex offset="after_parent">\s+dst_host="([^"]+)"</regex>
  <order>dst_host</order>
</decoder>

